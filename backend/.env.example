# ==============================================================================
# Emergency Response Platform - Backend Environment Configuration (.env.example)
# ==============================================================================

# Application Settings
APP_NAME=Emergency Response Platform API
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQL Server + SQLAlchemy 2.0 Async)
# Local Windows Authentication connection string format:
# mssql+aioodbc://@localhost/emergency_response_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&Trusted_Connection=yes
#
# SQL Authentication format (if SA / user credentials configured):
# mssql+aioodbc://<DB_USER>:<DB_PASSWORD>@localhost:1433/emergency_response_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DATABASE_URL=mssql+aioodbc://@localhost/emergency_response_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&Trusted_Connection=yes

# Redis & Celery (Async Jobs & Pub/Sub)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security & JWT Auth
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Third-Party Notification Providers
# Firebase Cloud Messaging (FCM)
FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json

# Twilio (SMS & Voice Fallbacks)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# SMTP (Email Alerts & Reports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=alerts@domain.com
