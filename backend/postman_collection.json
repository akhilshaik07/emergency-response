						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"first_name\": \"Aarav Updated\",\n    \"emergency_contact2\": {\n        \"name\": \"Vikram Patel\",\n        \"mobile\": \"+919876500088\",\n        \"relationship\": \"Brother\"\n    }\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/profile/me/",
					"host": ["{{baseUrl}}"],
					"path": ["api", "profile", "me", ""]
				}
			}
		},
