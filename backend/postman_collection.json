{
	"info": {
		"_postman_id": "4b7b2512-87a3-485a-a38f-9a1b899dc6a9",
		"name": "Community Emergency Response Platform (Django DRF)",
		"description": "Postman Collection strictly matching the mentor assignment grading checklist.\nIncludes Email/Mobile Login, JWT Authentication, Token-Scoped Profile CRUD, Role-Scoped Gated Society CRUD, and auto Bearer token injection.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://127.0.0.1:8000",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "refresh_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "society_id",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Auth - Register (Resident / Guardian)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"resident@example.com\",\n    \"mobile\": \"+919876500001\",\n    \"password\": \"Password123!\",\n    \"first_name\": \"Aarav\",\n    \"last_name\": \"Patel\",\n    \"group_id\": 5,\n    \"emergency_contact1\": {\n        \"name\": \"Pooja Patel\",\n        \"mobile\": \"+919876500099\",\n        \"relationship\": \"Spouse\"\n    },\n    \"medical_condition\": {\n        \"allergies\": \"Penicillin\",\n        \"blood_group\": \"O+\"\n    }\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/register/",
					"host": ["{{baseUrl}}"],
					"path": ["api", "auth", "register", ""]
				}
			}
		},
		{
			"name": "2. Auth - Login with Email",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.access) {",
							"    pm.collectionVariables.set(\"access_token\", jsonData.access);",
							"    pm.collectionVariables.set(\"refresh_token\", jsonData.refresh);",
							"    console.log(\"Saved access_token from Email Login!\");",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"resident@example.com\",\n    \"password\": \"Password123!\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/login/",
					"host": ["{{baseUrl}}"],
					"path": ["api", "auth", "login", ""]
				}
			}
		},
		{
			"name": "3. Auth - Login with Mobile (Mentor Spec)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.access) {",
							"    pm.collectionVariables.set(\"access_token\", jsonData.access);",
							"    pm.collectionVariables.set(\"refresh_token\", jsonData.refresh);",
							"    console.log(\"Saved access_token from Mobile Login!\");",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"mobile\": \"+919876500001\",\n    \"password\": \"Password123!\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/login/",
					"host": ["{{baseUrl}}"],
					"path": ["api", "auth", "login", ""]
				}
			}
		},
		{
			"name": "4. Auth - Token Refresh",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.access) {",
							"    pm.collectionVariables.set(\"access_token\", jsonData.access);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"refresh\": \"{{refresh_token}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/token/refresh/",
					"host": ["{{baseUrl}}"],
					"path": ["api", "auth", "token", "refresh", ""]
				}
			}
		},
		{
			"name": "5. Profile - Get My Profile (Token Scoped)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/profile/me/",
					"host": ["{{baseUrl}}"],
					"path": ["api", "profile", "me", ""]
				}
			}
		},
