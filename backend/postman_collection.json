				}
			}
		},
		{
			"name": "8. Gated Society - Add (Admin Only)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.id) {",
							"    pm.collectionVariables.set(\"society_id\", jsonData.id.toString());",
							"    console.log(\"Saved society_id:\", jsonData.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
